MODEL_API_KEY=
MODEL_NAME=muse-spark-1.3
VOICE_MODEL_NAME=muse-voice-transcribe-1.0
SAM_MODEL_NAME=sam-3.1
IMAGE_MODEL_NAME=muse-image-1.0
# Nudges from an open-weights Meta model (Muse Spark Open) on Baseten or Modal.
# NUDGE_ENGINE=open turns it on; if the call fails, nudges fall back to Muse Spark.
NUDGE_ENGINE=spark
OPEN_BASE_URL=
OPEN_API_KEY=
OPEN_MODEL=
# Modal shared endpoint, for the third Nudge voice choice: MODAL_BASE_URL (ends in /v1), MODAL_API_KEY (wk-id.ws-secret), MODAL_MODEL
MODAL_BASE_URL=
MODAL_API_KEY=
MODAL_MODEL=
# Baseten: OPEN_BASE_URL from its Quickstart, OPEN_MODEL=meta-models/muse-spark-open-1026
# OPEN_MAX_TOKENS=1000
# Most badge images the server will draw per day (default 20).
MAX_IMAGES_PER_DAY=20
# Most output tokens one badge image may use (default 2048). Lower it once the [usage] lines show the real cost.
IMAGE_MAX_OUTPUT_TOKENS=2048
# Optional: Resend sends the welcome email to new accounts (and the code when REQUIRE_SIGNUP_CODE=true). Without it, nothing is sent.
RESEND_API_KEY=
# Login with just an email (no code) is on for the demo. Set to true to ask for the emailed code on login too.
REQUIRE_LOGIN_CODE=false
# Signup also skips the emailed code for the demo. Set true to confirm new devices by email.
REQUIRE_SIGNUP_CODE=false
# Only used when REQUIRE_SIGNUP_CODE=true: the fixed code 123456 works whenever RESEND_API_KEY is empty. Set DEMO_CODE=anything to change it, or empty to turn it off.
DEMO_CODE=
# The sender of those emails. Resend only delivers from a domain you verified at resend.com/domains (add its DNS records, click Verify).
# Until then use Nudgy <onboarding@resend.dev>, which only reaches your own Resend account email.
EMAIL_FROM=Nudgy <welcome@getnudged.chat>

# Reminder limits (read by the app at build time; restart the dev server after changing)
VITE_MAX_OPEN_TASKS=30
VITE_PAGE_SIZE=10

# Accounts, synced data and images in a database. Leave empty to use server/data/db.json.
# Supabase: Connect > Direct Connection > choose Session pooler, copy the string, put your database password in place of [YOUR-PASSWORD].
#   Use the pooler one (the direct one is IPv6 only and Render can't reach it). Turn the project's Data API off.
#   postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Any other Postgres (e.g. Neon): postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# MySQL (e.g. cPanel):  mysql://USER:PASSWORD@HOST:3306/DBNAME  (the host must allow remote connections)
DATABASE_URL=
# Set the same DATABASE_URL, EMAIL_FROM and RESEND_API_KEY in Render > Environment, since .env is never pushed.
# DB_SSL=true

# Email reminders: an outside cron can POST /api/cron/reminders with "Authorization: Bearer CRON_SECRET". Empty turns that route off.
CRON_SECRET=
WONDER_MODEL_NAME=muse-wonder-1.0
PLAN_MODEL_NAME=muse-wonder-1.0
